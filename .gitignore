# Agent harness — runtime state and anything key-shaped.
# Private keys live under C:/ClaudeProfiles/<agent-id>/ and must never appear
# here; these patterns are a backstop, not the control. agent:harness:doctor
# scans .agent/ for key material regardless.
.agent/lease.json
.agent/sessions/*/events.ndjson.lock
.agent/**/*.key
