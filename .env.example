APP_NAME=CoreAgent
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=coreagent
DB_USERNAME=coreagent_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Whisper — transcribes WhatsApp voice notes (see WhatsAppMediaTranscriber).
# Shares OPENAI_API_KEY above; no other provider does speech-to-text, so a
# voice note is inert (a "not configured" reply) until this key is set.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Fallback order. qwen_lora last: cheapest to run, weakest to trust, so it
# should catch what the hosted APIs could not serve rather than pre-empt them.
CHAT_PROVIDER_PRIORITY=openai,deepseek,claude,qwen_gpu,qwen_lora

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4096

# Per-provider HTTP timeouts in seconds. These add up: three providers failing
# in sequence keeps the request open for the sum of all three.
OPENAI_TIMEOUT=30
DEEPSEEK_TIMEOUT=30
ANTHROPIC_TIMEOUT=60

# The same Qwen, reached over an SSH reverse tunnel to a GPU machine. Start it
# FROM the GPU machine, not the server:
#
#     ssh -N -R 127.0.0.1:11435:127.0.0.1:11434 <server>
#
# The remote end binds to loopback, so nothing is exposed publicly and no
# gateway or auth layer is needed. Tunnel down means connection refused, which
# fails instantly and falls through to QWEN_LORA on the server's own CPU — that
# is the expected steady state, not a fault.
QWEN_GPU_API_KEY=ollama-tunnel
QWEN_GPU_BASE_URL=
QWEN_GPU_MODEL=coreagent-qwen
QWEN_GPU_TIMEOUT=60
QWEN_GPU_SUPPORTS_TOOLS=false
# Self-hosted Qwen through Ollama's OpenAI-compatible endpoint.
#
# BASE_URL is the on/off switch: blank means unconfigured and ProviderRouter
# skips it. Local Ollama is http://127.0.0.1:11434/v1. Over a tunnel, use the
# public hostname — but Ollama has no auth of its own, so anything reachable
# from the internet MUST have something in front of it checking a credential,
# or you are donating the GPU to whoever finds the URL.
QWEN_LORA_API_KEY=ollama-local
QWEN_LORA_BASE_URL=
QWEN_LORA_MODEL=qwen2.5:3b

# Cold-start load into VRAM routinely outruns the 30s the hosted APIs need.
QWEN_LORA_TIMEOUT=120

# Small models accept a tools array and then emit invented calls, which costs a
# full agent round trip to discover. Turn on only after testing the model tag.
QWEN_LORA_SUPPORTS_TOOLS=false

# WhatsApp Cloud API (Meta) — see WHATSAPP_SETUP.md for how to get these from
# developers.facebook.com. All four must be set for the integration to work;
# WhatsAppWebhookController::verify() refuses the handshake otherwise.
#
# Chosen by you when you configure the webhook in Meta's dashboard — any
# random string, just needs to match on both sides.
WHATSAPP_VERIFY_TOKEN=
# Meta App → Settings → Basic → App Secret. Used to verify the
# X-Hub-Signature-256 header on every inbound webhook call.
WHATSAPP_APP_SECRET=
# Meta App → WhatsApp → API Setup → a permanent token (the default "temporary"
# token expires in 24h — generate a System User token for anything long-lived).
WHATSAPP_ACCESS_TOKEN=
# Meta App → WhatsApp → API Setup → Phone number ID (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# Only if Cloudflare Access fronts the tunnel — it wants its own header pair
# rather than the Authorization header QWEN_LORA_API_KEY goes into.
QWEN_LORA_CF_ACCESS_CLIENT_ID=
QWEN_LORA_CF_ACCESS_CLIENT_SECRET=

SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=
SEEDANCE_MODEL=seedance-1.0-lite
SEEDANCE_SUBMIT_PATH=/v1/video/generations
SEEDANCE_POLL_PATH=/v1/video/generations/{job_id}

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_MODEL=minimax-h3
MINIMAX_SUBMIT_PATH=/v1/video_generation
MINIMAX_POLL_PATH=/v1/query/video_generation

VIDEO_POLL_INTERVAL_SECONDS=15
VIDEO_POLL_MAX_ATTEMPTS=40
